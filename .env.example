FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production

# Leave DATABASE_URL unset to use instance/netrix.db automatically.
# Absolute SQLite example (recommended if you set it explicitly):
# DATABASE_URL=sqlite:////absolute/path/to/netrix/instance/netrix.db
# MySQL example:
# DATABASE_URL=mysql+pymysql://user:password@localhost/netrix

JWT_SECRET_KEY=another-long-random-secret-for-jwt
ADMIN_EMAIL=admin@netrix.local
ADMIN_PASSWORD=Admin@12345
