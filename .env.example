FLASK_APP=run.py
FLASK_ENV=production
SECRET_KEY=replace-with-a-long-random-secret-key

# Production: use Postgres (Neon, Supabase, Vercel Postgres, Railway, etc.)
# DATABASE_URL=postgresql://user:password@host:5432/netrix?sslmode=require
#
# Local SQLite (default if DATABASE_URL is unset):
# DATABASE_URL=sqlite:///instance/netrix.db

JWT_SECRET_KEY=another-long-random-secret

# Optional: create a single admin on first boot (no demo users)
# BOOTSTRAP_ADMIN_EMAIL=you@example.com
# BOOTSTRAP_ADMIN_PASSWORD=ChooseAStrongPassword

# SMTP — required to email PDF reports (Gmail example uses App Password)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=you@gmail.com

# Default admin (created automatically if missing)
BOOTSTRAP_ADMIN_EMAIL=admin@netrix.local
BOOTSTRAP_ADMIN_PASSWORD=change-this-to-a-strong-secret
# Set to 1 to force-reset the admin password on next start
# BOOTSTRAP_ADMIN_RESET=1
